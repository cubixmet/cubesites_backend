# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Database — leave ENGINE as sqlite for local; use postgres in staging/prod
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://cubesites:cubesites@127.0.0.1:5432/cubesites

# CORS — comma-separated origins for both React apps
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:8083,http://127.0.0.1:8083,http://localhost:8084,http://127.0.0.1:8084,http://localhost:8085,http://127.0.0.1:8085,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Media / static
MEDIA_URL=/media/
STATIC_URL=/static/

# JWT lifetime (minutes / days) — refresh keeps users signed in across visits
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=365

# Google Sign-In (Web application client — GIS ID token button).
# In Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0 Client:
#   Application type: Web application
#   Authorized JavaScript origins (required for the button):
#     http://localhost:8080
#     http://127.0.0.1:8080
#   Authorized redirect URIs:
#     http://localhost:8080/auth/google/callback
# Or drop the downloaded client_secret_*.json into this folder (gitignored).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
# Drive file backup OAuth (enable Google Drive API; add this redirect URI on the same Web client)
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/drive/callback/
FRONTEND_URL=http://localhost:8080

# SMTP for signup OTP emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
OTP_EXPIRY_MINUTES=10
